# Tushare Pro API token (required)
# Get your token at: https://tushare.pro/user/token
TUSHARE_TOKEN=YOUR_TUSHARE_TOKEN

# Data directory for Parquet files (optional, defaults to ./data_files)
DATA_DIR=./data_files

# Log directory (optional, defaults to ./logs)
LOG_DIR=./logs

# DuckDB database path (optional, defaults to ./data_files/quant.duckdb)
DUCKDB_PATH=./data_files/quant.duckdb
